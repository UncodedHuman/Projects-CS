@page
@model StudentNoteApp.Pages.Users.DetailsModel
@{
    ViewData["Title"] = "User Details";
}

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/Users/Index">Users</a></li>
                    <li class="breadcrumb-item active">@Model.User.FullName</li>
                </ol>
            </nav>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-body">
                    <div class="text-center mb-4">
                        <div class="display-6 text-primary mb-3">
                            <i class="bi bi-person-circle"></i>
                        </div>
                        <h2 class="h4">@Model.User.FullName</h2>
                        <p class="text-muted mb-0">@Model.User.Email</p>
                        <p class="text-muted">Role: @Model.User.Role</p>
                    </div>

                    @if (User.IsInRole("Admin"))
                    {
                                <div class="d-grid gap-2">
                                    <a href="/Users/Edit?id=@Model.User.Id" class="btn btn-outline-primary">
                                        <i class="bi bi-pencil me-2"></i>Edit User
                                    </a>
                                    <button type="button" class="btn btn-outline-danger" onclick="confirmDelete()">
                                        <i class="bi bi-trash me-2"></i>Delete User
                                    </button>
                                </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<form id="deleteForm" method="post" asp-page-handler="Delete" class="d-none">
    <input type="hidden" name="id" value="@Model.User.Id" />
</form>

@section Scripts {
            <script>
                function confirmDelete() {
                    if (confirm('Are you sure you want to delete this user? This action cannot be undone.')) {
                        document.getElementById('deleteForm').submit();
                    }
                }
            </script>
} 