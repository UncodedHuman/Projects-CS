@page
@model StudentNoteApp.Pages.Users.EditModel
@{
    ViewData["Title"] = "Edit User";
}

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/Users/Index">Users</a></li>
                    <li class="breadcrumb-item active">Edit User</li>
                </ol>
            </nav>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h2 class="h4 mb-4">Edit User</h2>

                    <form method="post">
                        <input type="hidden" asp-for="UserViewModel.Id" />
                        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

                        <div class="form-floating mb-3">
                            <input asp-for="UserViewModel.FullName" class="form-control" placeholder="Enter full name" />
                            <label asp-for="UserViewModel.FullName">Full Name</label>
                            <span asp-validation-for="UserViewModel.FullName" class="text-danger"></span>
                        </div>

                        <div class="form-floating mb-3">
                            <input asp-for="UserViewModel.Email" class="form-control" placeholder="Enter email" />
                            <label asp-for="UserViewModel.Email">Email</label>
                            <span asp-validation-for="UserViewModel.Email" class="text-danger"></span>
                        </div>

                        <div class="form-floating mb-4">
                            <select asp-for="UserViewModel.Role" asp-items="Model.AvailableRoles" class="form-select">
                            </select>
                            <label asp-for="UserViewModel.Role">Role</label>
                            <span asp-validation-for="UserViewModel.Role" class="text-danger"></span>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary flex-grow-1">
                                <i class="bi bi-check-circle me-2"></i>Save Changes
                            </button>
                            <button type="button" class="btn btn-danger" onclick="confirmDelete()">
                                <i class="bi bi-trash me-2"></i>Delete User
                            </button>
                            <a href="/Users/Index" class="btn btn-outline-secondary">Cancel</a>
                        </div>
                    </form>

                    <form id="deleteForm" method="post" asp-page-handler="Delete" class="d-none">
                        <input type="hidden" name="id" value="@Model.UserViewModel.Id" />
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
            <partial name="_ValidationScriptsPartial" />
            <script>
                function confirmDelete() {
                    if (confirm('Are you sure you want to delete this user? This action cannot be undone.')) {
                        document.getElementById('deleteForm').submit();
                    }
                }
            </script>
} 