@page
@model StudentNoteApp.Pages.Users.IndexModel
@{
    ViewData["Title"] = "Users";
}

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col-md-6">
            <h1 class="h3 mb-0">Users</h1>
        </div>
        <div class="col-md-6 text-end">
            @if (User.IsInRole("Admin"))
            {
                        <a href="/Identity/Account/Register" class="btn btn-primary">
                            <i class="bi bi-plus-lg me-2"></i>Add New User
                        </a>
            }
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            @if (!Model.Users.Any())
            {
                        <div class="text-center py-4">
                            <div class="display-6 text-muted mb-3">
                                <i class="bi bi-people"></i>
                            </div>
                            <p class="text-muted">No users found.</p>
                        </div>
            }
            else
            {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle">
                                <thead>
                                    <tr>
                                        <th>Full Name</th>
                                        <th>Email</th>
                                        <th>Role</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                            @foreach (var user in Model.Users)
                            {
                                                <tr>
                                                    <td>@user.FullName</td>
                                                    <td>@user.Email</td>
                                                    <td>@user.Role</td>
                                                    <td>
                                                        <div class="btn-group">
                                                            <a href="/Users/Details?id=@user.Id" class="btn btn-sm btn-outline-secondary">
                                                                <i class="bi bi-eye"></i>
                                                            </a>
                                            @if (User.IsInRole("Admin"))
                                            {
                                                                        <a href="/Users/Edit?id=@user.Id" class="btn btn-sm btn-outline-primary">
                                                                            <i class="bi bi-pencil"></i>
                                                                        </a>
                                                                        <button type="button" class="btn btn-sm btn-outline-danger"
                                                                            onclick="confirmDelete('@user.Id')">
                                                                            <i class="bi bi-trash"></i>
                                                                        </button>
                                            }
                                                        </div>
                                                    </td>
                                                </tr>
                            }
                                </tbody>
                            </table>
                        </div>
            }
        </div>
    </div>
</div>

<form id="deleteForm" method="post" asp-page-handler="Delete" class="d-none">
    <input type="hidden" id="userIdToDelete" name="id" value="" />
</form>

@section Scripts {
            <script>
                function confirmDelete(userId) {
                    if (confirm('Are you sure you want to delete this user? This action cannot be undone.')) {
                        document.getElementById('userIdToDelete').value = userId;
                        document.getElementById('deleteForm').submit();
                    }
                }
            </script>
} 