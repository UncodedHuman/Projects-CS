@page
@model IndexModel
@{
    ViewData["Title"] = "Student Notes Hub";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 text-center">
            <div class="mb-4">
                <i class="bi bi-journal-text display-1 text-primary"></i>
            </div>
            <h1 class="display-4 mb-3">Thames Care Agenda</h1>
            <p class="lead text-muted mb-4">A simple note-taking application for class materials</p>

            @if (!User.Identity.IsAuthenticated)
            {
                <div class="mt-4">
                    <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-primary btn-lg px-4">Sign In</a>
                </div>
            }
            else
            {
                <div class="mt-4">
                    <a asp-page="/AddNote/AddNote" class="btn btn-primary btn-lg px-4">Add New Note</a>
                </div>
            }
        </div>
    </div>
</div>
