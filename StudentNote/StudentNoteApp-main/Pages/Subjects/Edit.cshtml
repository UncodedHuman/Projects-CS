@page
@model StudentNoteApp.Pages.Subjects.EditModel
@{
    ViewData["Title"] = "Edit Subject";
}

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/Subjects/Index">Subjects</a></li>
                    <li class="breadcrumb-item active">Edit Subject</li>
                </ol>
            </nav>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h2 class="h4 mb-4">Edit Subject</h2>

                    <form method="post">
                        <input type="hidden" asp-for="Subject.Id" />
                        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

                        <div class="form-floating mb-3">
                            <input asp-for="Subject.Name" class="form-control" placeholder="Enter subject name" required />
                            <label asp-for="Subject.Name">Subject Name</label>
                            <span asp-validation-for="Subject.Name" class="text-danger"></span>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary flex-grow-1">
                                <i class="bi bi-check-circle me-2"></i>Save Changes
                            </button>
                            <button type="button" class="btn btn-danger" onclick="confirmDelete()">
                                <i class="bi bi-trash me-2"></i>Delete Subject
                            </button>
                            <a href="/Subjects/Index" class="btn btn-outline-secondary">Cancel</a>
                        </div>
                    </form>

                    <form id="deleteForm" method="post" asp-page-handler="Delete" class="d-none">
                        <input type="hidden" name="id" value="@Model.Subject.Id" />
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
            <partial name="_ValidationScriptsPartial" />
            <script>
                function confirmDelete() {
                    if (confirm('Are you sure you want to delete this subject? This action cannot be undone.')) {
                        document.getElementById('deleteForm').submit();
                    }
                }
            </script>
} 