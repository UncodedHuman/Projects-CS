@page
@model StudentNoteApp.Pages.Subjects.IndexModel
@{
    ViewData["Title"] = "Subjects";
}

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col-md-6">
            <h1 class="h3 mb-0">Subjects</h1>
        </div>
        <div class="col-md-6 text-end">
            @if (User.IsInRole("Admin"))
            {
                <a href="/Subjects/Add" class="btn btn-primary">
                    <i class="bi bi-plus-lg me-2"></i>Add New Subject
                </a>
            }
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            @if (!Model.Subjects.Any())
            {
                <div class="text-center py-4">
                    <div class="display-6 text-muted mb-3">
                        <i class="bi bi-book"></i>
                    </div>
                    <p class="text-muted">No subjects found.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Created</th>
                                <th>Last Modified</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var subject in Model.Subjects)
                            {
                                <tr>
                                    <td>@subject.Name</td>
                                    <td class="text-muted small">
                                        @subject.CreatedDateTime.ToString("g")<br />
                                        by @subject.CreatedBy
                                    </td>
                                    <td class="text-muted small">
                                        @if (subject.ModifiedDateTime.HasValue)
                                        {
                                            @subject.ModifiedDateTime.Value.ToString("g")

                                            <br />
                                            @:by @subject.ModifiedBy
                                        }
                                    </td>
                                    <td>
                                        <div class="btn-group">
                                            <a href="/Subjects/Details?id=@subject.Id" class="btn btn-sm btn-outline-secondary">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            @if (User.IsInRole("Admin"))
                                            {
                                                <a href="/Subjects/Edit?id=@subject.Id" class="btn btn-sm btn-outline-primary">
                                                    <i class="bi bi-pencil"></i>
                                                </a>
                                                <button type="button" class="btn btn-sm btn-outline-danger"
                                                    onclick="confirmDelete(@subject.Id)">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<form id="deleteForm" method="post" asp-page-handler="Delete" class="d-none">
    <input type="hidden" id="subjectIdToDelete" name="id" value="" />
</form>

@section Scripts {
    <script>
        function confirmDelete(subjectId) {
            if (confirm('Are you sure you want to delete this subject? This action cannot be undone.')) {
                document.getElementById('subjectIdToDelete').value = subjectId;
                document.getElementById('deleteForm').submit();
            }
        }
    </script>
}