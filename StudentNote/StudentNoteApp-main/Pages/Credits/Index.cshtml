@page
@model StudentNoteApp.Pages.Credits.IndexModel
@{
    ViewData["Title"] = "Credits";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Credits</h1>
    @if (User.IsInRole("Admin"))
    {
        <a asp-page="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle me-1"></i>Add New Credit
        </a>
    }
</div>

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Value</th>
                        <th>Display Text</th>
                        <th>Description</th>
                        <th>Is Numeric</th>
                        <th>Created</th>
                        <th>Last Modified</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var credit in Model.Credits)
                    {
                        <tr>
                            <td>@credit.Value</td>
                            <td>@credit.DisplayText</td>
                            <td>@credit.Description</td>
                            <td>@(credit.IsNumeric ? "Yes" : "No")</td>
                            <td>
                                @credit.CreatedDateTime.ToString("g")
                                by @credit.CreatedBy
                            </td>
                            <td>
                                @(credit.ModifiedDateTime?.ToString("g") ?? "Never")
                                by @credit.ModifiedBy
                            </td>
                            <td>
                                <div class="btn-group" role="group">
                                    <a asp-page="./Details" asp-route-id="@credit.Id"
                                        class="btn btn-outline-primary btn-sm">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-page="./Edit" asp-route-id="@credit.Id" class="btn btn-outline-primary btn-sm">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <button type="button" class="btn btn-outline-danger btn-sm"
                                        onclick="confirmDelete(@credit.Id)">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<form id="deleteForm" method="post" asp-page-handler="Delete">
    <input type="hidden" id="creditId" name="id" />
</form>

@section Scripts {
    <script>
        function confirmDelete(id) {
            if (confirm('Are you sure you want to delete this credit?')) {
                document.getElementById('creditId').value = id;
                document.getElementById('deleteForm').submit();
            }
        }
    </script>
}