@page "{id:int}"
@model StudentNoteApp.Pages.Credits.DetailsModel
@{
    ViewData["Title"] = "Credit Details";
}

<div class="container">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-page="./Index">Credits</a></li>
            <li class="breadcrumb-item active">Credit Details</li>
        </ol>
    </nav>

    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header">
                    <h4 class="mb-0">Credit Details</h4>
                </div>
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-3">Value</dt>
                        <dd class="col-sm-9">@Model.Credit.Value</dd>

                        <dt class="col-sm-3">Display Text</dt>
                        <dd class="col-sm-9">@Model.Credit.DisplayText</dd>

                        <dt class="col-sm-3">Description</dt>
                        <dd class="col-sm-9">@Model.Credit.Description</dd>

                        <dt class="col-sm-3">Is Numeric</dt>
                        <dd class="col-sm-9">@(Model.Credit.IsNumeric ? "Yes" : "No")</dd>

                        <dt class="col-sm-3">Created</dt>
                        <dd class="col-sm-9">
                            @Model.Credit.CreatedDateTime.ToString("g") by @Model.Credit.CreatedBy
                        </dd>

                        <dt class="col-sm-3">Last Modified</dt>
                        <dd class="col-sm-9">
                            @(Model.Credit.ModifiedDateTime?.ToString("g") ?? "Never") by @Model.Credit.ModifiedBy
                        </dd>
                    </dl>

                    <div class="d-flex justify-content-between mt-3">
                        <div>
                            <a asp-page="./Index" class="btn btn-secondary me-2">Back to List</a>
                            <a asp-page="./Edit" asp-route-id="@Model.Credit.Id" class="btn btn-primary">Edit</a>
                        </div>
                        <button type="button" class="btn btn-danger" onclick="confirmDelete()">Delete</button>
                    </div>

                    <form id="deleteForm" method="post" asp-page-handler="Delete">
                        <input type="hidden" asp-for="Credit.Id" />
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function confirmDelete() {
            if (confirm('Are you sure you want to delete this credit?')) {
                document.getElementById('deleteForm').submit();
            }
        }
    </script>
}