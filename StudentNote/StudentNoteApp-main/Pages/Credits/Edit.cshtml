@page "{id:int}"
@model StudentNoteApp.Pages.Credits.EditModel
@{
    ViewData["Title"] = "Edit Credit";
}

<div class="container">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-page="./Index">Credits</a></li>
            <li class="breadcrumb-item active">Edit Credit</li>
        </ol>
    </nav>

    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header">
                    <h4 class="mb-0">Edit Credit</h4>
                </div>
                <div class="card-body">
                    <form method="post">
                        <input type="hidden" asp-for="Credit.Id" />
                        <div class="mb-3">
                            <label asp-for="Credit.Value" class="form-label">Value</label>
                            <input asp-for="Credit.Value" class="form-control" />
                            <span asp-validation-for="Credit.Value" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Credit.DisplayText" class="form-label">Display Text</label>
                            <input asp-for="Credit.DisplayText" class="form-control" />
                            <span asp-validation-for="Credit.DisplayText" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Credit.Description" class="form-label">Description</label>
                            <textarea asp-for="Credit.Description" class="form-control" rows="3"></textarea>
                            <span asp-validation-for="Credit.Description" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <div class="form-check">
                                <input asp-for="Credit.IsNumeric" class="form-check-input" type="checkbox" />
                                <label asp-for="Credit.IsNumeric" class="form-check-label">Is Numeric</label>
                            </div>
                        </div>
                        <div class="d-flex justify-content-between">
                            <div>
                                <a asp-page="./Index" class="btn btn-secondary me-2">Cancel</a>
                                <button type="submit" class="btn btn-primary">Save</button>
                            </div>
                            <button type="button" class="btn btn-danger" onclick="confirmDelete()">Delete</button>
                        </div>
                    </form>

                    <form id="deleteForm" method="post" asp-page-handler="Delete">
                        <input type="hidden" asp-for="Credit.Id" />
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
<script>
    function confirmDelete() {
        if (confirm('Are you sure you want to delete this credit?')) {
            document.getElementById('deleteForm').submit();
        }
    }
</script>
}