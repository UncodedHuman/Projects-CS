@page
@model StudentNoteApp.Pages.Students.IndexModel
@{
    ViewData["Title"] = "Students";
}

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col">
            <div class="d-flex justify-content-between align-items-center">
                <h1 class="h3 mb-0">Students</h1>
                @if (User.IsInRole("Admin"))
                {
                    <a href="/Students/Add" class="btn btn-primary">
                        <i class="bi bi-plus-lg me-2"></i>Add Student
                    </a>
                }
            </div>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            @if (!Model.Students.Any())
            {
                <div class="text-center py-4">
                    <div class="display-6 text-muted mb-3">
                        <i class="bi bi-people"></i>
                    </div>
                    <p class="text-muted">No students found.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Student Number</th>
                                <th>Year</th>
                                <th>Created</th>
                                <th>Last Modified</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var student in Model.Students)
                            {
                                <tr>
                                    <td>@student.LastName, @student.FirstName</td>
                                    <td>@student.StudentNumber</td>
                                    <td>@student.Year</td>
                                    <td class="text-muted small">
                                        @student.CreatedDateTime.ToString("g")<br />
                                        by @student.CreatedBy
                                    </td>
                                    <td class="text-muted small">
                                        @if (student.ModifiedDateTime.HasValue)
                                        {
                                            @student.ModifiedDateTime.Value.ToString("g")
                                            <br />
                                            @:by @student.ModifiedBy
                                        }
                                    </td>
                                    <td>
                                        <div class="btn-group">
                                            <a href="/Students/Details?id=@student.Id" class="btn btn-sm btn-outline-secondary">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            @if (User.IsInRole("Admin"))
                                            {
                                                <a href="/Students/Edit?id=@student.Id" class="btn btn-sm btn-outline-primary">
                                                    <i class="bi bi-pencil"></i>
                                                </a>
                                                <button type="button" class="btn btn-sm btn-outline-danger"
                                                    onclick="confirmDelete(@student.Id)">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<form id="deleteForm" method="post" asp-page-handler="Delete" class="d-none">
    <input type="hidden" id="studentIdToDelete" name="id" value="" />
</form>

@section Scripts {
    <script>
        function confirmDelete(studentId) {
            if (confirm('Are you sure you want to delete this student? This action cannot be undone.')) {
                document.getElementById('studentIdToDelete').value = studentId;
                document.getElementById('deleteForm').submit();
            }
        }
    </script>
}