@page
@model StudentNoteApp.Pages.Students.AddModel
@{
    ViewData["Title"] = "Add Student";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm border-0 rounded-3">
                <div class="card-body p-4">
                    <div class="text-center mb-4">
                        <div class="mb-3">
                            <i class="bi bi-person-plus display-5 text-primary"></i>
                        </div>
                        <h1 class="h3">Add New Student</h1>
                        <p class="text-muted">Enter student information</p>
                    </div>

                    @if (!ModelState.IsValid)
                    {
                                <div class="alert alert-danger">
                                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                                </div>
                    }

                    <form method="post">
                        <div class="row g-4">
                            <div class="col-md-6">
                                <div class="form-floating mb-3">
                                    <input asp-for="Student.FirstName" class="form-control" placeholder="First Name" required />
                                    <label asp-for="Student.FirstName">First Name</label>
                                    <span asp-validation-for="Student.FirstName" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-floating mb-3">
                                    <input asp-for="Student.LastName" class="form-control" placeholder="Last Name" required />
                                    <label asp-for="Student.LastName">Last Name</label>
                                    <span asp-validation-for="Student.LastName" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-floating mb-3">
                                    <input asp-for="Student.StudentNumber" class="form-control" placeholder="Student Number" required />
                                    <label asp-for="Student.StudentNumber">Student Number</label>
                                    <span asp-validation-for="Student.StudentNumber" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-floating mb-3">
                                    <input asp-for="Student.Year" type="number" class="form-control" placeholder="Year" required min="1" max="12" />
                                    <label asp-for="Student.Year">Year</label>
                                    <span asp-validation-for="Student.Year" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex gap-2 mt-4">
                            <button type="submit" class="btn btn-primary flex-grow-1">
                                <i class="bi bi-plus-circle me-2"></i>Add Student
                            </button>
                            <a href="/Students/Index" class="btn btn-outline-secondary">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
            <partial name="_ValidationScriptsPartial" />
} 